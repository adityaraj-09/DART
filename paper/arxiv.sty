% arXiv-style preprint layout (letter, 10pt, running header).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{arxiv}[2026/09/18 DART arXiv preprint style]

\renewcommand{\rmdefault}{ptm}
\renewcommand{\sfdefault}{phv}

\usepackage[letterpaper,margin=1in]{geometry}
\usepackage{fancyhdr}

\widowpenalty=10000
\clubpenalty=10000
\flushbottom
\sloppy

\newcommand{\headeright}{arXiv preprint}
\newcommand{\undertitle}{arXiv preprint}
\newcommand{\shorttitle}{DART}

\fancyhf{}
\pagestyle{fancy}
\renewcommand{\headrulewidth}{0.4pt}
\rhead{\scshape\footnotesize\headeright}
\lhead{\scshape\footnotesize\shorttitle}
\cfoot{\thepage}

\renewcommand{\normalsize}{%
  \@setfontsize\normalsize\@xpt\@xipt
  \abovedisplayskip 7\p@ \@plus 2\p@ \@minus 5\p@
  \belowdisplayskip \abovedisplayskip
}
\normalsize
\renewcommand{\small}{\@setfontsize\small\@ixpt\@xpt}
\renewcommand{\footnotesize}{\@setfontsize\footnotesize\@ixpt\@xpt}
\renewcommand{\large}{\@setfontsize\large\@xiipt{14}}
\renewcommand{\Large}{\@setfontsize\Large\@xivpt{16}}
\renewcommand{\LARGE}{\@setfontsize\LARGE\@xviipt{20}}

\renewcommand{\section}{%
  \@startsection{section}{1}{\z@}%
  {-2.0ex \@plus -0.5ex \@minus -0.2ex}%
  {1.5ex \@plus 0.3ex \@minus 0.2ex}%
  {\large\bfseries\raggedright}}
\renewcommand{\subsection}{%
  \@startsection{subsection}{2}{\z@}%
  {-1.8ex \@plus -0.5ex \@minus -0.2ex}%
  {0.8ex \@plus 0.2ex}%
  {\normalsize\bfseries\raggedright}}
\renewcommand{\subsubsection}{%
  \@startsection{subsubsection}{3}{\z@}%
  {-1.5ex \@plus -0.5ex \@minus -0.2ex}%
  {0.5ex \@plus 0.2ex}%
  {\normalsize\bfseries\raggedright}}

\setlength{\parindent}{0pt}
\setlength{\parskip}{5.5pt}

\renewcommand{\maketitle}{%
  \par\begingroup
  \thispagestyle{empty}%
  \vspace*{0.15in}%
  {\hrule height 2pt}%
  \vspace{0.22in}%
  \begin{center}
    {\LARGE\bfseries \@title\par}
  \end{center}
  \vspace{0.18in}%
  {\hrule height 2pt}%
  \vspace{0.12in}%
  \begin{center}
    {\scshape\undertitle}\\[0.18in]
    {\large\bfseries \@author}\\[0.12in]
    {\normalsize \@date}
  \end{center}
  \vspace{0.25in}%
  \endgroup
  \let\maketitle\relax
}

\renewenvironment{abstract}{%
  \centerline{\large\bfseries\scshape Abstract}%
  \begin{quote}\small
}{%
  \end{quote}
}

\newcommand{\keywords}[1]{%
  \par\vspace{0.4em}{\small\textbf{\emph{Keywords.}} #1\par}}
